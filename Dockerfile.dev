FROM alpine:3.19

RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories
RUN apk add --no-cache ca-certificates tzdata wget

RUN addgroup -g 1000 -S appuser &&     adduser -u 1000 -S appuser -G appuser

WORKDIR /app

COPY platform-service-linux ./platform-service
COPY config.*.yaml ./

RUN mkdir -p /app/data && chown -R appuser:appuser /app

USER appuser

ENV PLATFORM_PORT=8195
ENV PLATFORM_CONFIG_FILE=config.dev
EXPOSE 8095 8195

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3   CMD wget --no-verbose --tries=1 --spider http://localhost:${PLATFORM_PORT}/healthz || exit 1

CMD ["sh", "-c", "exec ./platform-service -config ${PLATFORM_CONFIG_FILE:-config.dev}"]
